function CheckForTrackingPage() {
    try {
        // Get the current URL
        const windowPath = window.location.href;
        const path = new URL(windowPath).pathname; // Extracts the path from the URL
        const parts = path.split('/').filter(Boolean); // Removes empty strings

        return (
            parts[0] === 'myaccount' &&
            parts[1] === 'parcel-tracking' &&
            !isNaN(parts[2]) &&
            !isNaN(parts[3]) &&
            parts.length === 4
        );
    } catch (e) {
        return false; // Invalid URL format
    }
}

