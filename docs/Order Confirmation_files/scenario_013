ConfirmitHelper.ConfirmitLog(showLog, logString + "nthVisitor: START Checking Status...");

// If the visitor has not been seen before then tag them
if (!sessionStorage.getItem(surveyID + "_nth_checked")) {
	sessionStorage.setItem(surveyID + "_nth_checked", "User Checked");

	// Start to generate a session seed as one not found yet
	ConfirmitHelper.ConfirmitLog(showLog, logString + "nthVisitor: Generating Session value - " + surveyID + "_nth");
	ConfirmitHelper.ConfirmitLog(showLog, logString + "nthVisitor: Seed value - " + nthSeed);
