	ConfirmitHelper.ConfirmitLog(showLog, logString + "nthVisitor: nthSeed= " + nthSeed + " vs nthRandomNumber= " + nthRandomNumber);
	if (nthRandomNumber <= nthSeed) {
		sessionStorage.setItem(surveyID + "_nth_inScope", "nthVisitor: nthSeed= " + nthSeed + " vs nthRandomNumber= " + nthRandomNumber);
		ConfirmitHelper.ConfirmitLog(showLog, logString + "nthVisitor: Generating session variable");
	} else {
		ConfirmitHelper.ConfirmitLog(showLog, logString + "nthVisitor: Random not in seed so NO session variable");
	}
}

// If the respondent has been checked already and they are within Scope, let them pass else stop script
if (sessionStorage.getItem(surveyID + "_nth_checked") && sessionStorage.getItem(surveyID + "_nth_inScope")) {
	ConfirmitHelper.ConfirmitLog(showLog, logString + "nthVisitor: Already checked and in scope, continuing...");
}else{
	ConfirmitHelper.ConfirmitLog(showLog, logString + "nthVisitor: Already checked but not in scope, exiting...");
