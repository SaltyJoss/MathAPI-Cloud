		dfInst.container(containerName);
		dfInst.data(dataObject);
		dfInst.survey(pid);
		dfInst.show();

	dfInst.events.showInvite.on(function (e) {

		var pagesVisited = JSON.parse(sessionStorage.getItem('confirmitPagesVisited'));

		// Capture Basic Information
		ExitIntentHelper.DataPackage("M", DFProgramID, DFProgramVersion, pageCount, pagesVisited, conf_lng);

		// Capture Additional information and write to session
		ExitIntentHelper.ExitIntentAddInfo();

		ConfirmitHelper.ConfirmitLog(showLog, logString + "Showing Invite...");

		let prevData = JSON.parse(sessionStorage.getItem('objConfCS'));

		var date = new Date();
		var now_epoc = Date.UTC(date.getUTCFullYear(), date.getUTCMonth(),
			date.getUTCDate(), date.getUTCHours(),
			date.getUTCMinutes(), date.getUTCSeconds());

		prevData['DF_Shown_InviteEPOC'] = now_epoc;
		prevData['DF_Shown_InviteDATE'] = date;
		sessionStorage.setItem('objConfCS', JSON.stringify(prevData));

		ConfirmitHelper.setCookie(surveyCookie, '1', { path: '/', expiry: cookieExpireDays * 86400, secure: true, samesite: 'None' });
	});

	dfInst.events.acceptInvite.on(function (e) {
		let prevData = JSON.parse(sessionStorage.getItem('objConfCS'));
		var date = new Date();
		var now_epoc = Date.UTC(date.getUTCFullYear(), date.getUTCMonth(),
			date.getUTCDate(), date.getUTCHours(),
			date.getUTCMinutes(), date.getUTCSeconds());

		prevData['DF_Shown_SurveyEPOC'] = now_epoc;
		prevData['DF_Shown_SurveyDATE'] = date;
		sessionStorage.setItem('objConfCS', JSON.stringify(prevData));

		// re-read the latest session info
		var dataObject = JSON.parse(sessionStorage.getItem("objConfCS"));
		dfInst.data(dataObject);

	});

	dfInst.events.completeSurvey.on(function () {
		ConfirmitHelper.ConfirmitLog(showLog, logString + "Dropping Complete Cookie");
		// Drop complete cookie
		ConfirmitHelper.setCookie(surveyCookie, '2', {
		path: '/',
		expiry: cookieExpireDaysComplete * 86400,
		secure: true,
		samesite: 'None'
		});
	});
};

// Scenario 1: Timeout function
/*
var waitTime = ((TimeOnSite*60)*1000);
ConfirmitHelper.ConfirmitLog(showLog,logString + " Loading program with timeout of " + waitTime + " (milliseconds)");
ConfirmitHelper.ConfirmitLog(showLog,logString + " which is " + (Math.round(waitTime)/1000) + " (seconds)")
ConfirmitHelper.ConfirmitLog(showLog,logString + " which is " + ((Math.round(waitTime)/1000))/60 + " (minutes)")
setTimeout(fn, waitTime);
*/

if (pageCount >= (viewPages+1)) {
	ConfirmitHelper.ConfirmitLog(showLog, logString + "Visited " + pageCount + " page(s) while threshold is " + viewPages + " Running");
    setTimeout(fn, 2000);
}else{
	ConfirmitHelper.ConfirmitLog(showLog, logString + "Visited " + pageCount + " page(s) while threshold is " + viewPages + " Exiting");
	return;
}
}



